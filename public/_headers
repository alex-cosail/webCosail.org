# cosail.org (Astro) — docs/TZ_Site.md §6, partiya G.
# Old Flutter / AI Studio headers removed (X-Frame-Options, CORS *, service worker).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro build files have a hash in the name -> cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Screenshots keep their names when replaced -> short cache, check with the server.
/media/*
  Cache-Control: public, max-age=3600, must-revalidate
