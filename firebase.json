{
  "hosting": {
    "site": "cosail-org-ru",
    "public": "dist",
    "cleanUrls": false,
    "trailingSlash": true,
    "ignore": ["firebase.json", "**/.*", "_headers"],
    "redirects": [
      { "source": "/", "destination": "/ru/", "type": 302 },
      { "regex": "^/en$", "destination": "/en/", "type": 301 }
    ],
    "rewrites": [
      { "source": "/en/", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ] },
      { "source": "**/*.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "regex": "^(.*/)?$", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "/_astro/**", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
      { "source": "/media/**", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" } ] }
    ]
  }
}
